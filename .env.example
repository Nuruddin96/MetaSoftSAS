APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# 120 (Laravel's stock default) is a short idle window for a panel/PWA a
# tenant opens intermittently through the day rather than continuously —
# combined with "মনে রাখুন" now defaulting to checked on the login form,
# most staff won't hit this ceiling at all (remember-me issues its own
# long-lived cookie via users.remember_token, unaffected by this value).
# This is still the idle-session fallback for anyone who unchecks it, so a
# longer value here directly addresses "reopened later, asked to log in
# again" without weakening anything — same server-side session mechanism,
# just a longer idle allowance. 10080 = 7 days.
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (config/filesystems.php's 'r2' disk) — only used by code
# that explicitly calls Storage::disk('r2'); the app's default disk stays
# FILESYSTEM_DISK above. R2_ENDPOINT is the account-level S3 API endpoint
# (https://{account_id}.r2.cloudflarestorage.com); R2_URL is the public
# base URL files are actually served from (bucket's r2.dev subdomain, or
# a mapped custom domain). Never commit real values here or anywhere else
# — set them only in the real, untracked .env.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_REGION=auto

VITE_APP_NAME="${APP_NAME}"

# Facebook / Messenger — one Meta App serves every tenant.
# FB_APP_SECRET and FB_MESSENGER_VERIFY_TOKEN already existed before the
# OAuth flow (config/messenger.php, webhook signature verification) but
# were never documented here — included for completeness.
FB_APP_ID=
FB_APP_SECRET=
FB_MESSENGER_VERIFY_TOKEN=

# Facebook OAuth "Connect Facebook" (Phase 1). FB_OAUTH_REDIRECT_URI must
# exactly match a "Valid OAuth Redirect URI" registered in the Meta App
# dashboard — leave blank to fall back to the named `facebook.callback`
# route (recommended unless the callback host needs to differ from APP_URL).
FB_OAUTH_REDIRECT_URI=
FB_OAUTH_SCOPES=pages_show_list,pages_manage_metadata,pages_messaging
FB_OAUTH_STATE_TTL_MINUTES=10
FB_GRAPH_VERSION=v26.0

# Messenger customer identity (name + profile photo, messenger_customers /
# FacebookMessengerCustomerService — Phase 1.1). How many hours a stored
# identity is trusted before it's refetched from Graph on the next inbound
# message; existed in config/messenger.php before this table was wired up,
# never documented here until now.
MESSENGER_PROFILE_REFRESH_HOURS=24

# WhatsApp Cloud API webhook (Phase 2). Set in Meta App -> WhatsApp ->
# Configuration -> Webhook. Own verify token, separate from
# FB_MESSENGER_VERIFY_TOKEN, even though both webhooks share the same
# FB_APP_SECRET above (one Meta App).
WHATSAPP_VERIFY_TOKEN=

# WhatsApp Cloud API send service (Phase 3) — falls back to FB_GRAPH_VERSION if unset.
WHATSAPP_GRAPH_VERSION=

# WhatsApp Embedded Signup "Connect WhatsApp" (Phase 4). Reuses FB_APP_ID/
# FB_APP_SECRET above (same Meta App) — this is the one extra value the
# Embedded Signup popup needs, created in Meta App -> WhatsApp ->
# Configuration -> Embedded Signup.
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_OAUTH_STATE_TTL_MINUTES=10

# AI Customer Support Agent — off for every tenant until they explicitly
# enable it in Settings AND have been allocated AI credit by Super Admin,
# regardless of these being set. See config/ai.php for defaults/fallbacks;
# nothing here is required for the rest of the app to keep working.
# AI_PROVIDER selects which App\Services\AI\Providers\AiProviderInterface
# implementation is used (see AppServiceProvider) — 'openai' is the only
# one implemented so far.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Credit/wallet system (Phase 1) — how many credit units are deducted per
# 1,000 total tokens of a successful OpenAI call. See config/ai.php.
AI_CREDIT_PER_1K_TOKENS=1.0
